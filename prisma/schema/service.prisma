model Services {
  id                       String        @id @default(uuid())
  title                    String
  heading                  String
  description              String?
  criticalFriction         String?
  agentarumParadigm        String?
  hardTangibleDeliverables String[]      @default([])
  serviceGroupId           String?
  serviceGroup             ServiceGroup? @relation(fields: [serviceGroupId], references: [id], onDelete: SetNull)

  deepPoints  DeepPoint[]
  submissions ServiceSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceGroupId])
}

model ServiceGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Services[]

  @@index([name])
}

model DeepPoint {
  id               String   @id @default(uuid())
  title            String
  description      String?
  criticalFriction String?
  paradigm         String?
  keyFeatures      String[]

  serviceId String
  service   Services @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}
