model ContentItem {
  id                 String             @id @default(uuid())
  contentTypeId      String
  slug               String             @unique
  title              String
  subtitle           String?
  excerpt            String?
  summary            String?
  plainTextBody      String?
  authorDisplayName  String?
  coverImageUrl      String?
  thumbnailUrl       String?
  status             PublishStatus      @default(DRAFT)
  visibility         ContentVisibility  @default(PUBLIC)
  accessModel        ContentAccessModel @default(PUBLIC)
  contentFormat      ContentFileFormat?
  externalUrl        String?
  externalEmbedCode  String?
  readingTimeMinutes Int?
  publishedAt        DateTime?
  scheduledAt        DateTime?
  archivedAt         DateTime?
  isFeatured         Boolean            @default(false)
  isPinned           Boolean            @default(false)
  allowComments      Boolean            @default(false)
  viewCount          BigInt             @default(0)
  downloadCount      BigInt             @default(0)
  createdById        String?
  updatedById        String?
  publishedById      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  fileUrl                    String?
  isDownloadable             Boolean @default(true)
  downloadRequiresAcceptance Boolean @default(false)
  termsText                  String?

  contentType           ContentType           @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  contentCategories     ContentCategory[]
  contentTags           ContentTag[]
  accessRules           ContentAccessRule[]
  entitlements          Entitlement[]
  userContentProgresses UserContentProgress[]
  userActivityLogs      UserActivityLog[]
  ratings               ContentRating[]
  bookmarks             ContentBookmark[]

  @@index([contentTypeId])
  @@index([status, publishedAt])
  @@index([visibility])
  @@index([accessModel])
  @@index([isFeatured])
  @@index([isPinned])
}

model ContentType {
  id          String          @id @default(uuid())
  code        ContentTypeCode @unique
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contentItems ContentItem[]
}

model ContentCategory {
  id            String   @id @default(uuid())
  contentItemId String
  categoryId    String
  createdAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, categoryId])
  @@index([contentItemId])
  @@index([categoryId])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentCategory[]

  @@index([isActive])
}

model ContentTag {
  id            String   @id @default(uuid())
  contentItemId String
  tagId         String
  createdAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, tagId])
  @@index([contentItemId])
  @@index([tagId])
}

model Tag {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentTags ContentTag[]

  @@index([isActive])
}

model ContentBookmark {
  id            String   @id @default(uuid())
  userId        String
  contentItemId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([userId])
  @@index([contentItemId])
}

model ContentAccessRule {
  id            String             @id @default(uuid())
  contentItemId String
  ruleType      AccessRuleType
  operator      AccessRuleOperator
  ruleValue     Json
  priority      Int                @default(0)
  allowAccess   Boolean            @default(true)
  message       String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([ruleType])
  @@index([isActive])
}

model AppSetting {
  id          String   @id @default(uuid())
  groupName   String
  key         String
  value       Json
  isPublic    Boolean  @default(false)
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([groupName, key])
  @@index([groupName])
}
