generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  emailVerified     Boolean          @default(false)
  emailVerifiedAt   DateTime?
  passwordHash      String?
  firstName         String?
  lastName          String?
  fullName          String?
  avatarUrl         String?
  phone             String?
  timezone          String?
  preferredLanguage String?          @default("en")
  status            UserStatus       @default(PENDING_VERIFICATION)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  signupSource      AuthProviderType @default(LOCAL)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  // Relations
  roles                                 UserRole[]
  authProviders                         AuthProvider[]
  sessions                              UserSession[]
  userOtps                              UserOtp[]
  subscriptions                         Subscription[]
  entitlements                          Entitlement[]
  patreonConnection                     PatreonConnection?
  assignedInquiries                     ContactInquiry[]               @relation("InquiryAssignedTo")
  relatedInquiries                      ContactInquiry[]               @relation("InquiryRelatedUser")
  inquiryActivities                     InquiryActivity[]
  grantedEntitlements                   Entitlement[]                  @relation("EntitlementGrantedBy")
  revokedEntitlements                   Entitlement[]                  @relation("EntitlementRevokedBy")
  updatedSettings                       AppSetting[]                   @relation("AppSettingUpdatedBy")
  emailLogs                             EmailLog[]
  auditLogs                             AuditLog[]
  passwordResetTokens                   PasswordResetToken[]
  subscriptionEvents                    SubscriptionEvent[]
  customSubscriptionAssignments         CustomSubscriptionAssignment[] @relation("CustomAssignmentUser")
  assignedCustomSubscriptionAssignments CustomSubscriptionAssignment[] @relation("CustomAssignmentAdmin")
  notifications                         Notification[]
  notificationTokens                    NotificationToken[]
  notificationSetting                   NotificationSetting?
  conversationMembers                   ConversationMember[]
  messages                              Message[]
  readReceipts                          MessageReadReceipt[]
  userContentProgresses                 UserContentProgress[]
  userActivityLogs                      UserActivityLog[]
  ratings                               ContentRating[]
  contentBookmarks                      ContentBookmark[]
  parentUserId                          String?
  parentUser                            User?                          @relation("TeamMembers", fields: [parentUserId], references: [id], onDelete: SetNull)
  teamMembers                           User[]                         @relation("TeamMembers")
  teamInvitations                       TeamInvitation[]
  teamRole                              TeamRole?
  joinRequests                          TeamJoinRequest[]              @relation("UserJoinRequests")
  adminJoinRequests                     TeamJoinRequest[]              @relation("AdminJoinRequests")
}

model Role {
  id          String       @id @default(uuid())
  code        UserRoleCode @unique
  name        String
  description String?
  isSystem    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userRoles     UserRole[]
  adminSettings AdminSettings?
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceName       String?
  deviceType       String?
  browser          String?
  os               String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserOtp {
  id           String     @id @default(uuid())
  userId       String
  email        String
  purpose      OtpPurpose
  otpCodeHash  String
  expiresAt    DateTime
  verifiedAt   DateTime?
  usedAt       DateTime?
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthProvider {
  id                    String           @id @default(uuid())
  userId                String
  provider              AuthProviderType
  providerUserId        String
  providerEmail         String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  rawProfile            Json?
  isPrimary             Boolean          @default(false)
  linkedAt              DateTime         @default(now())
  lastSyncedAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

model AdminSettings {
  id                String  @id @default(uuid())
  canManageUsers    Boolean @default(false)
  canManageContent  Boolean @default(false)
  canManageBilling  Boolean @default(false)
  canManageSettings Boolean @default(false)

  role Role @relation(fields: [id], references: [id], onDelete: Cascade)
}
