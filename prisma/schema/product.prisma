model Product {
  id String @id @default(uuid())

  title                          String
  subTitle                       String
  module                         String
  description                    String
  scaleValueImpact               Json?
  mitigationVector               Json?
  platformCapabilitiesDescriptor Json?

  retailBanking                  Json?
  capitalMarkets                 Json?
  wealthAndAsset                 Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions ProductSubmission[]
}
