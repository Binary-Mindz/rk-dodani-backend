model Plan {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  planTitle       String?
  description     String?
  targetAudience  PlanAudience    @default(B2C)
  billingProvider BillingProvider @default(STRIPE)
  stripeProductId String?
  stripePriceId   String?
  billingInterval BillingInterval
  currency        String
  priceAmount     Decimal         @db.Decimal(12, 2)
  isPerUser       Boolean         @default(false)
  trialDays       Int             @default(0)
  isAutoRenew     Boolean         @default(true)
  isPublic        Boolean         @default(true)
  isActive        Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  sortOrder       Int             @default(0)
  maxUsers        Int             @default(1)
  subtitle        String?
  features        Json?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions                 Subscription[]
  entitlements                  Entitlement[]
  customSubscriptionAssignments CustomSubscriptionAssignment[]

  @@index([isPublic])
  @@index([isActive])
  @@index([targetAudience])
  @@index([sortOrder])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  planId                 String
  provider               BillingProvider    @default(STRIPE)
  providerSubscriptionId String?
  providerCustomerId     String?
  providerPriceId        String?
  status                 SubscriptionStatus
  startedAt              DateTime?
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  billingEmail           String?
  lastPaymentAt          DateTime?
  lastPaymentAmount      Decimal?           @db.Decimal(12, 2)
  currency               String?
  failureReason          String?
  seats                  Int                @default(1)
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptionEvents SubscriptionEvent[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model SubscriptionEvent {
  id              String          @id @default(uuid())
  subscriptionId  String?
  userId          String?
  provider        BillingProvider
  providerEventId String
  eventType       String
  eventPayload    Json
  processed       Boolean         @default(false)
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime        @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([subscriptionId])
  @@index([userId])
  @@index([processed])
}

model CustomSubscriptionAssignment {
  id                String                             @id @default(uuid())
  userId            String
  assignedBy        String?
  planId            String
  checkoutSessionId String                             @unique
  checkoutUrl       String
  amount            Decimal                            @db.Decimal(12, 2)
  currency          String
  billingInterval   BillingInterval
  seats             Int                                @default(1)
  status            CustomSubscriptionAssignmentStatus @default(PENDING)
  note              String?
  paidAt            DateTime?
  subscriptionId    String?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt

  user           User  @relation("CustomAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("CustomAssignmentAdmin", fields: [assignedBy], references: [id], onDelete: SetNull)
  plan           Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([assignedBy])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
}

model PatreonConnection {
  id                    String    @id @default(uuid())
  userId                String    @unique
  patreonUserId         String    @unique
  patreonEmail          String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  campaignId            String?
  membershipStatus      String?
  patreonTierId         String?
  patreonTierTitle      String?
  pledgeAmountCents     Int?
  lastVerifiedAt        DateTime?
  lastSyncStatus        String?
  lastSyncError         String?
  rawProfile            Json?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model Entitlement {
  id              String                @id @default(uuid())
  userId          String
  sourceType      EntitlementSourceType
  sourceId        String?
  entitlementType EntitlementType
  planId          String?
  contentItemId   String?
  status          EntitlementStatus     @default(PENDING)
  startsAt        DateTime?
  endsAt          DateTime?
  grantedById     String?
  revokedById     String?
  revokedAt       DateTime?
  reason          String?
  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  grantedBy   User?        @relation("EntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy   User?        @relation("EntitlementRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([planId])
  @@index([contentItemId])
  @@index([status, endsAt])
}
